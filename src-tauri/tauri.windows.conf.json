{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PolyUI",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "visible": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "//": "CEF runtime. libcef.dll is a load-time dependency of the executable and resolves icudtl.dat, the pak files and locales from its own directory, so all of it has to land beside the exe. On Windows that is exactly where Tauri puts resources, unlike Linux where the DT_NEEDED layout forces bundle.linux.*.files instead.",
    "resources": {
      "target/release/libcef.dll": "libcef.dll",
      "target/release/chrome_elf.dll": "chrome_elf.dll",
      "target/release/d3dcompiler_47.dll": "d3dcompiler_47.dll",
      "target/release/libEGL.dll": "libEGL.dll",
      "target/release/libGLESv2.dll": "libGLESv2.dll",
      "target/release/vk_swiftshader.dll": "vk_swiftshader.dll",
      "target/release/vulkan-1.dll": "vulkan-1.dll",
      "target/release/vk_swiftshader_icd.json": "vk_swiftshader_icd.json",
      "target/release/icudtl.dat": "icudtl.dat",
      "target/release/chrome_100_percent.pak": "chrome_100_percent.pak",
      "target/release/chrome_200_percent.pak": "chrome_200_percent.pak",
      "target/release/resources.pak": "resources.pak",
      "target/release/v8_context_snapshot.bin": "v8_context_snapshot.bin",
      "target/release/locales/en-US.pak": "locales/en-US.pak"
    }
  }
}
